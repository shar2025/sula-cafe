			.mobile-menu{position:fixed;top:0;right:0;bottom:0;width:100%;max-width:380px;background:linear-gradient(180deg,var(--espresso-deep) 0%,var(--espresso) 50%,var(--cocoa-deep) 100%);transform:translateX(100%);transition:transform 0.4s ease;z-index:99;overflow-y:auto;padding:90px 32px 40px;box-shadow:-10px 0 40px rgba(0,0,0,0.5)}
