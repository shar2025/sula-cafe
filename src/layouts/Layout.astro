						<g transform="translate(-1,0)">
							<path d="M11 5 Q12.5 7 11 9 Q9.5 11 11 13" opacity="0.55"/>
							<path d="M16 3.5 Q17.8 6 16 8.5 Q14.2 11 16 13" opacity="0.85"/>
							<path d="M21 5 Q22.5 7 21 9 Q19.5 11 21 13" opacity="0.55"/>
