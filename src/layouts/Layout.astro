			</div>
			<p class="header-strip">260 East 5th Ave · East Vancouver &nbsp;·&nbsp; Takeout · UberEats</p>
			<div class="header-bottom-zigzag" aria-hidden="true"></div>
		</header>

		<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
			<div class="mobile-menu-inner">
				<div class="mobile-menu-logo">
					<img width="300" height="136" src="/uploads/2025/09/sula-cafe-logo-2026.webp" alt="Sula Café" />
				</div>
				<a href="/" class="mobile-menu-item">Home</a>
				<a href="/coffee-and-chai-in-vancouver" class="mobile-menu-item">Coffee &amp; Chai</a>
				<a href="/menu" class="mobile-menu-item">Menu</a>
				<a href="/catering" class="mobile-menu-item">Catering</a>
				<a href="/wholesale" class="mobile-menu-item">Wholesale</a>
				<a href="/stories" class="mobile-menu-item">Stories</a>
				<a href="/contact" class="mobile-menu-item">Contact</a>
				<div class="mobile-menu-divider"></div>
				<p class="mobile-menu-label">Visit Us</p>
				<p class="mobile-menu-info">260 East 5th Ave<br/>East Vancouver<br/>778-386-1130</p>
				<a href="https://www.instagram.com/sula.cafe" target="_blank" rel="noopener noreferrer" aria-label="Follow Sula Cafe on Instagram" class="mobile-menu-follow">
					<span class="mobile-menu-follow-badge">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="3" y="3" width="18" height="18" rx="5" ry="5"/>
							<circle cx="12" cy="12" r="4"/>
							<circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
						</svg>
					</span>
					<span class="mobile-menu-follow-label">Follow @sula.cafe</span>
				</a>
				<a href="https://www.order.store/store/sula-cafe/0egsttFCUIahN8Ja4Uqhtw" class="mobile-menu-cta" target="_blank" rel="noopener">
					<span>Order on UberEats</span>
					<svg class="cta-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
