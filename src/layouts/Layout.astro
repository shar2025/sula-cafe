			.hero{position:relative;display:flex;align-items:center;justify-content:center;text-align:center;padding:70px 32px 50px;color:var(--cocoa);background:linear-gradient(180deg,var(--cream) 0%,var(--cream-soft) 100%);overflow:hidden;animation:fadeIn 1.2s ease}
