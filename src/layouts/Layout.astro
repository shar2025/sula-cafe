		</style>
		<script is:inline>
			const observer = new IntersectionObserver((entries)=>{
				entries.forEach(entry=>{
					if(entry.isIntersecting){
						entry.target.classList.add('visible');
						observer.unobserve(entry.target);
					}
				});
			},{threshold:0.01});
			document.querySelectorAll('.reveal,.reveal-left,.reveal-right,.reveal-scale').forEach(el=>observer.observe(el));

			const hamburger = document.getElementById('hamburger-btn');
			const mobileMenu = document.getElementById('mobile-menu');
			const mobileMenuClose = document.getElementById('mobile-menu-close');
			const body = document.body;
			function isMenuOpen(){
				return body.classList.contains('menu-open');
			}
			function setMenu(open){
				body.classList.toggle('menu-open', open);
				mobileMenu.classList.toggle('active', open);
				hamburger.classList.toggle('active', open);
				hamburger.setAttribute('aria-expanded', open ? 'true' : 'false');
				mobileMenu.setAttribute('aria-hidden', open ? 'false' : 'true');
			}
			hamburger.addEventListener('click', (e)=>{
				e.stopPropagation();
				setMenu(!isMenuOpen());
			});
			if (mobileMenuClose) {
				mobileMenuClose.addEventListener('click', (e)=>{
					e.stopPropagation();
					setMenu(false);
				});
			}
			document.querySelectorAll('.mm-item, .mm-cta, .mm-icon').forEach(link=>{
				link.addEventListener('click', ()=>{ if(isMenuOpen()) setMenu(false); });
			});

			const siteHeader = document.querySelector('.site-header');
			let isHeaderScrolled = false;
			function handleHeaderScroll(){
				const should = window.scrollY > 24;
				if(should && !isHeaderScrolled){
					siteHeader.classList.add('scrolled');
					isHeaderScrolled = true;
				} else if(!should && isHeaderScrolled){
					siteHeader.classList.remove('scrolled');
					isHeaderScrolled = false;
				}
			}
			window.addEventListener('scroll', handleHeaderScroll, {passive:true});
			document.addEventListener('keydown', (e)=>{
				if(e.key === 'Escape' && isMenuOpen()) setMenu(false);
			});

			/* Active state on the desktop nav chips, based on the current path. */
			(function paintActiveChip(){
				const path = window.location.pathname.replace(/\/$/, '') || '/';
				document.querySelectorAll('.nav-chip').forEach(chip => {
					const target = (chip.getAttribute('data-path') || '').replace(/\/$/, '') || '/';
					if (target === path) chip.classList.add('is-active');
				});
			})();

			/* OPEN/CLOSED indicator, live in Vancouver time. Mon-Fri 8-5:30,
			   Sat-Sun 9-5:30. The pill dot turns grey and the label flips when
			   we're closed; same logic feeds the mobile menu's pill. */
			(function paintStatus(){
				const HOURS = {0:[9,17.5],6:[9,17.5],1:[8,17.5],2:[8,17.5],3:[8,17.5],4:[8,17.5],5:[8,17.5]};
				function vanNow(){
					try {
						const s = new Date().toLocaleString('en-US', { timeZone: 'America/Vancouver' });
						return new Date(s);
					} catch(e){ return new Date(); }
				}
				function paint(){
					const now = vanNow();
					const day = now.getDay();
					const t = now.getHours() + now.getMinutes()/60;
					const range = HOURS[day];
					const open = range && t >= range[0] && t < range[1];
					const closeTime = range ? range[1] : 17.5;
					const closeHour = Math.floor(closeTime);
					const closeMin = Math.round((closeTime - closeHour) * 60);
					const closeStr = (((closeHour + 11) % 12) + 1) + (closeMin ? (':' + String(closeMin).padStart(2,'0')) : '') + (closeHour >= 12 ? 'pm' : 'am');
					const dStatus = document.getElementById('nav-status');
					const dText = document.getElementById('status-text');
					const mText = document.getElementById('mm-status-text');
					if (dStatus) dStatus.classList.toggle('is-closed', !open);
					if (dText) dText.textContent = open ? 'Open' : 'Closed';
					if (mText) mText.textContent = open ? ('Open · until ' + closeStr) : 'Closed today';
				}
				paint();
				setInterval(paint, 60 * 1000);
			})();
		</script>

		<div class="theme-switch" role="group" aria-label="Colour mode: Daylight, Mocha, Espresso">
			<span class="theme-switch-label" id="theme-switch-label">Daylight</span>
			<button type="button" class="theme-seg" data-theme-mode="light" aria-label="Daylight, the bright linen cafe">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4"/>
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
				</svg>
			</button>
			<button type="button" class="theme-seg" data-theme-mode="mocha" aria-label="Mocha, warm cocoa midtone">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M5 9 h11 a3 3 0 0 1 0 6 h-1 v1.5 a3 3 0 0 1 -3 3 H8 a3 3 0 0 1 -3 -3 Z"/>
					<path d="M16 11.5 a1.5 1.5 0 0 1 0 3"/>
					<path d="M9 4.5 q1 1.4 0 2.6 M12 4 q1 1.4 0 2.6"/>
				</svg>
			</button>
			<button type="button" class="theme-seg" data-theme-mode="dark" aria-label="Espresso, the deep dark cafe">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
				</svg>
			</button>
		</div>
		<script is:inline>
			(() => {
				var sw = document.querySelector('.theme-switch');
				if (!sw) return;
				var THEMES = ['light', 'mocha', 'dark'];
				var LEGACY = { saffron: 'mocha' };
				/* Address-bar tint per mode, aligned to the body surface. */
				var CHROME = { light: '#FAF7EE', mocha: '#DDC8AA', dark: '#241712' };
				var NAMES = { light: 'Daylight', mocha: 'Mocha', dark: 'Espresso' };
				var labelEl = document.getElementById('theme-switch-label');
				var segs = sw.querySelectorAll('[data-theme-mode]');
				var root = document.documentElement;
				function currentMode() {
					var t = root.getAttribute('data-theme');
					if (LEGACY[t]) t = LEGACY[t];
					return THEMES.indexOf(t) !== -1 ? t : 'light';
				}
				function paint(mode) {
					if (mode === 'light') root.removeAttribute('data-theme');
					else root.setAttribute('data-theme', mode);
					segs.forEach(function (el) {
						el.classList.toggle('is-active', el.dataset.themeMode === mode);
					});
					if (labelEl) labelEl.textContent = NAMES[mode];
					var m1 = document.querySelector('meta[name="theme-color"]');
					var m2 = document.querySelector('meta[name="msapplication-navbutton-color"]');
					if (m1) m1.setAttribute('content', CHROME[mode]);
					if (m2) m2.setAttribute('content', CHROME[mode]);
				}
				paint(currentMode());
				segs.forEach(function (btn) {
					btn.addEventListener('click', function () {
						var mode = btn.dataset.themeMode;
						if (mode === currentMode()) return;
						paint(mode);
						try { localStorage.setItem('sula-cafe-theme', mode); } catch (e) {}
					});
				});
			})();
		</script>
		<Chai />
