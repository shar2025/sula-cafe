						<p><a href="mailto:info@sulacafe.com">info@sulacafe.com</a></p>
						<p><a href="https://www.instagram.com/sula.cafe" target="_blank" rel="noopener noreferrer" aria-label="Sula Cafe on Instagram" class="footer-social">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<rect x="3" y="3" width="18" height="18" rx="5" ry="5"/>
								<circle cx="12" cy="12" r="4"/>
								<circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
							</svg>
							<span>@sula.cafe</span>
						</a></p>
					</div>
					<div class="footer-col footer-family">
