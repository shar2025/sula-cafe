---
import Chai from '../components/Chai.astro';
const {
	title = "Coffee & Chai in East Vancouver | Sula Café",
	description = "Sula chai brewed slow with leaves from Coorg, Alai Coffee blend, croissants and cruffins baked daily. Drop by 260 East 5th Ave in East Vancouver.",
	canonical = "/",
	ogImage = "/uploads/2026/02/sula-cafe-near-me-vancouver.webp",
	breadcrumbs = null,
	noIndex = false
} = Astro.props;
const fullCanonical = `https://sulacafe.com${canonical}`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `https://sulacafe.com${ogImage}`;

const orgSchema = {
	"@context": "https://schema.org",
	"@type": ["CafeOrCoffeeShop", "FoodEstablishment", "LocalBusiness"],
	"@id": "https://sulacafe.com/#organization",
	"name": "Sula Café",
	"alternateName": ["Sula Café", "Sula Cafe Vancouver"],
	"url": "https://sulacafe.com",
	"logo": "https://sulacafe.com/uploads/2025/09/sula-cafe-logo-2026.webp",
	"image": "https://sulacafe.com/uploads/2026/02/sula-cafe-near-me-vancouver.webp",
	"telephone": "+1-778-386-1130",
	"email": "info@sulacafe.com",
	"priceRange": "$$",
	"currenciesAccepted": "CAD",
	"paymentAccepted": "Cash, Credit Card, Debit Card",
	"servesCuisine": ["Indian", "Coffee", "Café", "Bakery", "Chai"],
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "260 East 5th Avenue",
		"addressLocality": "Vancouver",
		"addressRegion": "BC",
		"postalCode": "V5T 1H3",
		"addressCountry": "CA"
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 49.26628631891023,
		"longitude": -123.0992136625663
	},
	"openingHoursSpecification": [
		{ "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "08:00", "closes": "17:30" },
		{ "@type": "OpeningHoursSpecification", "dayOfWeek": ["Saturday","Sunday"], "opens": "09:00", "closes": "17:30" }
	],
	"areaServed": [
		{ "@type": "City", "name": "Vancouver" },
		{ "@type": "City", "name": "Burnaby" },
		{ "@type": "Place", "name": "East Vancouver" },
		{ "@type": "Place", "name": "Mount Pleasant" },
		{ "@type": "Place", "name": "Main Street" }
	],
	"sameAs": [
		"https://sulaindianrestaurant.com/",
		"https://sulacatering.com/",
		"https://www.instagram.com/sula.cafe"
	],
	"hasMenu": "https://sulacafe.com/menu",
	"acceptsReservations": false,
	"takeOut": true,
	"delivery": true,
	"potentialAction": {
		"@type": "OrderAction",
		"target": {
			"@type": "EntryPoint",
			"urlTemplate": "https://www.order.store/store/sula-cafe/0egsttFCUIahN8Ja4Uqhtw",
			"actionPlatform": [
				"http://schema.org/DesktopWebPlatform",
				"http://schema.org/IOSPlatform",
				"http://schema.org/AndroidPlatform"
			]
		},
		"deliveryMethod": [
			"http://purl.org/goodrelations/v1#DeliveryModeOwnFleet",
			"http://purl.org/goodrelations/v1#DeliveryModePickUp"
		]
	}
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": "https://sulacafe.com/#website",
	"url": "https://sulacafe.com",
	"name": "Sula Café",
	"description": "Authentic chai, Alai Coffee, and fresh-baked pastries in East Vancouver.",
	"publisher": { "@id": "https://sulacafe.com/#organization" },
	"inLanguage": "en-CA"
};

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": breadcrumbs.map((c, i) => {
		const entry = {
			"@type": "ListItem",
			"position": i + 1,
			"name": c.name
		};
		if (c.url) entry.item = `https://sulacafe.com${c.url}`;
		return entry;
	})
} : null;
---
<!doctype html>
<html lang="en-CA">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#FAF7EE" />
		<meta name="msapplication-navbutton-color" content="#FAF7EE" />
		<!-- Apply the saved brand theme before first paint to avoid a flash.
		     Default (no saved value) is the light scheme, so the site looks
		     unchanged on first visit and for crawlers. -->
		<script is:inline>
			(() => {
				try {
					var THEMES = ['light', 'mocha', 'dark'];
					var LEGACY = { saffron: 'mocha' };
					/* Browser chrome (Android Chrome address bar, PWA toolbar)
					   tints from these values; matched 1:1 to the body bg of
					   each mode so there is no seam between the address bar
					   and the page surface. */
					var CHROME = { light: '#FAF7EE', mocha: '#DDC8AA', dark: '#241712' };
					var saved = localStorage.getItem('sula-cafe-theme');
					if (LEGACY[saved]) {
						saved = LEGACY[saved];
						try { localStorage.setItem('sula-cafe-theme', saved); } catch (e) {}
					}
					var mode = THEMES.indexOf(saved) !== -1 ? saved : 'light';
					if (mode !== 'light') {
						document.documentElement.setAttribute('data-theme', mode);
					}
					var m1 = document.querySelector('meta[name="theme-color"]');
					var m2 = document.querySelector('meta[name="msapplication-navbutton-color"]');
					if (m1) m1.setAttribute('content', CHROME[mode]);
					if (m2) m2.setAttribute('content', CHROME[mode]);
				} catch (e) {}
			})();
		</script>
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={fullCanonical} />
		<link rel="alternate" hreflang="en-CA" href={fullCanonical} />
		<link rel="alternate" hreflang="x-default" href={fullCanonical} />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" href="/favicon.ico" />
		<meta property="og:type" content={canonical.startsWith('/blog/') ? 'article' : 'website'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={fullOgImage} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:url" content={fullCanonical} />
		<meta property="og:site_name" content="Sula Café" />
		<meta property="og:locale" content="en_CA" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={fullOgImage} />
		<meta name="twitter:image:alt" content={title} />
		<meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
		<meta name="geo.region" content="CA-BC" />
		<meta name="geo.placename" content="Vancouver" />
		<meta name="geo.position" content="49.26628631891023;-123.0992136625663" />
		<meta name="ICBM" content="49.26628631891023, -123.0992136625663" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Red+Rose:wght@300;400;500;600;700&display=swap" />
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Red+Rose:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
		<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
		{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
		<slot name="schema" />
	</head>
	<body>
		<header class="site-header" id="site-header">
			<div class="nav-capsule" id="nav-capsule">
				<a href="/" class="nav-mark" aria-label="Sula Café Home">
