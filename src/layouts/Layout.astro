					</div>
					<div class="footer-col">
						<h4>Useful Links</h4>
						<a href="/">Home</a>
						<a href="/coffee-and-chai-in-vancouver">Coffee &amp; Chai</a>
						<a href="/menu">Menu</a>
						<a href="/catering">Catering</a>
