---
/**
 * PosLayout: touch-first shell for every /pos page. Theme tokens only (light /
 * mocha / dark, same palette as the marketing Layout). No marketing chrome, no
 * Chai widget. Top nav comes from src/lib/tabs.ts, filtered by role.
 *
 * Props:
 *   title     page title
 *   session   PosSession | null (drives nav + staff chip)
 *   active    current tab href, e.g. '/pos/'
 *   showNav   default true; login page passes false
 */
import type { PosSession } from '../lib/access.ts';
import { posTabs } from '../lib/tabs.ts';

interface Props {
  title?: string;
  session?: PosSession | null;
  active?: string;
  showNav?: boolean;
}
const { title = 'Sula Cafe POS', session = null, active = '', showNav = true } = Astro.props;
const tabs = posTabs(session?.role);
---
<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="theme-color" content="#FAF7EE" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
  <script is:inline>
    (() => {
      try {
        var THEMES = ['light', 'mocha', 'dark'];
        var saved = localStorage.getItem('sula-cafe-theme');
        var mode = THEMES.indexOf(saved) !== -1 ? saved : 'light';
        if (mode !== 'light') document.documentElement.setAttribute('data-theme', mode);
      } catch (e) {}
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet" />
  <noscript><style>.reveal,.reveal-left,.reveal-right{opacity:1 !important;transform:none !important}</style></noscript>
</head>
<body>
  <style is:global>
    :root{
      --cream:#FAF7EE;--cream-soft:#F0E9D5;--cream-deep:#E2D6B7;--tan:#AC8B5A;--tan-soft:#C2A37C;
      --cocoa:#4F2F1B;--cocoa-mid:#3A2110;--cocoa-deep:#261309;--espresso:#2D1B14;--espresso-deep:#1a0e08;
      --burnt:#A0511E;--burnt-light:#C0723A;--burnt-deep:#7C3D14;--text-dark:#1A0F06;--text-soft:#3A2410;
      --ink:#1A0F06;--copper-line:rgba(79,47,27,0.20);--copper-line-soft:rgba(79,47,27,0.10);
      --ok:#2E7D32;--warn:#B8551E;--danger:#B23A2E;--surface:#FFFFFF;
    }
    :root[data-theme="mocha"]{
      --cream:#DDC8AA;--cream-soft:#CDB590;--cream-deep:#BBA075;--tan:#87623E;--tan-soft:#A07F5D;
      --cocoa:#3D2110;--cocoa-mid:#2D170A;--cocoa-deep:#1F0E05;--espresso:#2E1A0C;--espresso-deep:#1F1108;
      --burnt:#903E10;--burnt-light:#B8551E;--burnt-deep:#6D2E0A;--text-dark:#18100A;--text-soft:#2D170A;
      --ink:#18100A;--copper-line:rgba(61,33,16,0.32);--copper-line-soft:rgba(61,33,16,0.15);
      --ok:#2E7D32;--warn:#B8551E;--danger:#A8392C;--surface:#E7D6BB;
    }
    :root[data-theme="dark"]{
      --cream:#241712;--cream-soft:#2D1B14;--cream-deep:#3a2618;--tan:#E6C893;--tan-soft:#D9B57A;
      --cocoa:#F0DDBC;--cocoa-mid:#E3CBA0;--cocoa-deep:#F3E3C3;--espresso:#EDDCBC;--espresso-deep:#14100C;
      --burnt:#E08A4E;--burnt-light:#F0A064;--burnt-deep:#C77A3E;--text-dark:#F3E3C3;--text-soft:#D8C39C;
      --ink:#F1DCB4;--copper-line:rgba(230,200,147,0.22);--copper-line-soft:rgba(230,200,147,0.10);
      --ok:#6FBF73;--warn:#F0A064;--danger:#E8796B;--surface:#2D1B14;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    html,body{overflow-x:clip}
    body{font-family:'Inter',system-ui,sans-serif;color:var(--ink);background:var(--cream);line-height:1.4;-webkit-tap-highlight-color:transparent;min-height:100vh}
    h1,h2,h3{font-family:'Playfair Display',Georgia,serif;color:var(--cocoa);font-weight:600;letter-spacing:-0.3px}
    a{color:var(--burnt);text-decoration:none}
    :focus-visible{outline:2px solid var(--burnt);outline-offset:2px}
    img{max-width:100%;display:block}
    .reveal{opacity:0;transform:translateY(16px);transition:opacity .5s ease,transform .5s ease}
    .reveal.visible{opacity:1;transform:none}

    /* ---- top bar ---- */
    .pos-top{position:sticky;top:0;z-index:50;display:flex;align-items:center;gap:8px;
      padding:10px 16px;background:var(--surface);border-bottom:1px solid var(--copper-line);
      box-shadow:0 2px 10px rgba(45,27,20,0.06)}
    .pos-brand{font-family:'Playfair Display',serif;font-size:18px;font-weight:600;color:var(--cocoa);white-space:nowrap}
    .pos-nav{display:flex;gap:4px;flex:1;overflow-x:auto;scrollbar-width:none}
    .pos-nav::-webkit-scrollbar{display:none}
    .pos-tab{display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border-radius:12px;
      font-size:13px;font-weight:600;letter-spacing:.02em;color:var(--cocoa-mid);white-space:nowrap;
      background:transparent;border:1px solid transparent;transition:background .2s,color .2s}
    .pos-tab svg{width:18px;height:18px;flex-shrink:0}
    .pos-tab:hover{background:color-mix(in oklab,var(--burnt) 10%,transparent)}
    .pos-tab.is-active{background:var(--cocoa-deep);color:var(--cream);border-color:var(--cocoa-deep)}
    :root[data-theme="dark"] .pos-tab.is-active{color:var(--espresso-deep)}
    .pos-staff{display:flex;align-items:center;gap:10px;margin-left:auto;white-space:nowrap}
    .pos-chip{display:inline-flex;align-items:center;gap:7px;padding:7px 12px;border-radius:999px;
      background:color-mix(in oklab,var(--burnt) 12%,transparent);font-size:12px;font-weight:600;color:var(--cocoa)}
    .pos-chip .role{font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--burnt);font-weight:700}
    .pos-iconbtn{width:40px;height:40px;border-radius:10px;border:1px solid var(--copper-line);
      background:transparent;color:var(--cocoa);display:inline-flex;align-items:center;justify-content:center;cursor:pointer}
    .pos-iconbtn:active{transform:scale(.96)}

    /* ---- shared UI ---- */
    .pos-main{padding:16px;max-width:1280px;margin:0 auto}
    .pos-card{background:var(--surface);border:1px solid var(--copper-line);border-radius:16px;padding:18px}
    .pos-btn{appearance:none;border:1px solid var(--burnt);background:var(--burnt);color:#F3E3C3;
      font-family:inherit;font-size:15px;font-weight:600;padding:14px 20px;border-radius:12px;cursor:pointer;
      min-height:50px;transition:background .2s,transform .1s;letter-spacing:.02em}
    .pos-btn:hover{background:var(--burnt-deep)}
    .pos-btn:active{transform:scale(.98)}
    .pos-btn:disabled{opacity:.45;cursor:not-allowed}
    .pos-btn.ghost{background:transparent;color:var(--cocoa);border-color:var(--copper-line)}
    .pos-btn.ghost:hover{background:color-mix(in oklab,var(--burnt) 10%,transparent)}
    .pos-btn.danger{background:var(--danger);border-color:var(--danger);color:#fff}
    .pos-btn.block{width:100%}
    .pos-input,.pos-select{width:100%;font-family:inherit;font-size:15px;padding:13px 14px;border-radius:12px;
      border:1px solid var(--copper-line);background:var(--cream);color:var(--ink);min-height:48px}
    .pos-label{display:block;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
      color:var(--burnt);margin-bottom:6px}
    .pos-h1{font-size:26px;margin-bottom:4px}
    .pos-sub{color:var(--text-soft);font-size:14px;margin-bottom:18px}
    .pos-banner{display:flex;gap:10px;align-items:flex-start;padding:12px 16px;border-radius:12px;
      background:color-mix(in oklab,var(--warn) 14%,transparent);border:1px solid color-mix(in oklab,var(--warn) 40%,transparent);
      color:var(--cocoa);font-size:13px;margin-bottom:16px}
    .pos-tablewrap{overflow-x:auto;border:1px solid var(--copper-line);border-radius:14px;background:var(--surface)}
    table.pos-table{width:100%;border-collapse:collapse;font-size:14px;min-width:520px}
    table.pos-table th{text-align:left;font-size:10px;letter-spacing:.1em;text-transform:uppercase;
      color:var(--burnt);font-weight:700;padding:12px 14px;border-bottom:1px solid var(--copper-line)}
    table.pos-table td{padding:12px 14px;border-bottom:1px solid var(--copper-line-soft);color:var(--ink);vertical-align:middle}
    table.pos-table tr:last-child td{border-bottom:0}
    .pos-pill{display:inline-block;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:.04em}
    .pos-pill.ok{background:color-mix(in oklab,var(--ok) 20%,transparent);color:var(--ok)}
    .pos-pill.warn{background:color-mix(in oklab,var(--warn) 22%,transparent);color:var(--warn)}
    .pos-pill.off{background:color-mix(in oklab,var(--danger) 18%,transparent);color:var(--danger)}
    .pos-empty{text-align:center;color:var(--text-soft);padding:40px 16px;font-size:15px}
    @media(max-width:640px){
      .pos-brand{display:none}
      .pos-main{padding:12px}
      .pos-h1{font-size:22px}
    }
  </style>

  {showNav && (
    <header class="pos-top">
      <span class="pos-brand">Sula POS</span>
      <nav class="pos-nav" aria-label="POS sections">
        {tabs.map((t) => (
          <a href={t.href} class={`pos-tab${active === t.href ? ' is-active' : ''}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={t.icon} /></svg>
            <span>{t.label}</span>
          </a>
        ))}
      </nav>
      <div class="pos-staff">
        {session && (
          <span class="pos-chip"><span class="role">{session.role}</span>{session.name}</span>
        )}
        <button class="pos-iconbtn" id="pos-theme" aria-label="Cycle theme" type="button">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9c-5 0-9-4-9-9z"/></svg>
        </button>
        {session && (
          <form method="POST" action="/api/pos-auth" style="display:inline">
            <input type="hidden" name="action" value="logout" />
            <button class="pos-iconbtn" aria-label="Log out" type="submit">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
            </button>
          </form>
        )}
      </div>
    </header>
  )}

  <main class="pos-main">
    <slot />
  </main>

  <script is:inline>
    (() => {
      // Scroll reveal (no-JS fallback handled by <noscript> above).
      var io = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
      }, { threshold: 0.04 });
      document.querySelectorAll('.reveal,.reveal-left,.reveal-right').forEach((el) => io.observe(el));

      var t = document.getElementById('pos-theme');
      if (t) t.addEventListener('click', function () {
        var THEMES = ['light', 'mocha', 'dark'];
        var cur = document.documentElement.getAttribute('data-theme') || 'light';
        var next = THEMES[(THEMES.indexOf(cur) + 1) % THEMES.length];
        if (next === 'light') document.documentElement.removeAttribute('data-theme');
        else document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('sula-cafe-theme', next); } catch (e) {}
      });
    })();
  </script>
</body>
</html>
