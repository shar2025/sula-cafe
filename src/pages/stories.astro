---
import Layout from '../layouts/Layout.astro';
---
<Layout
	title="Stories | Chai & Coffee Journal | Sula Café Vancouver"
	description="Slow reads on chai, specialty coffee, and the craft behind every cup. Notes from Sula Chai Café in East Vancouver."
	canonical="/stories"
	ogImage="/uploads/2025/10/Lavender-chai.webp"
	breadcrumbs={[
		{ name: 'Home', url: '/' },
		{ name: 'Stories', url: '/stories' }
	]}
>

	<section class="hero">
		<div class="hero-content">
			<span class="eyebrow-italic">Stories from Sula</span>
			<h1>A journal of chai, <em>coffee, and craft.</em></h1>
			<div class="premium-divider">
				<div class="pd-thin"></div>
				<div class="pd-thick"></div>
				<div class="pd-diamond"></div>
				<div class="pd-thick"></div>
				<div class="pd-thin-r"></div>
			</div>
			<p class="hero-tagline">Slow reads on chai, coffee, and the craft behind every cup.</p>
		</div>
	</section>

	<section class="section section-cream-reverse reveal">
		<div class="container">
			<div class="card-grid-3">
				<a href="/blog/art-of-chai" class="photo-card reveal delay-100">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/10/Masala-chai.webp" alt="Authentic masala chai brewing in Vancouver" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Chai Culture</span>
						<h3>The Art of <em>Chai</em></h3>
						<p>From the misty hills of Coorg to your cup in East Vancouver, the journey of authentic chai and what makes a great brew.</p>
					</div>
				</a>

				<a href="/blog/specialty-coffee-vancouver" class="photo-card reveal delay-200">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/12/a4.jpg" alt="Specialty Indian coffee in Vancouver" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Coffee Craftsmanship</span>
						<h3>Specialty Coffee, <em>Indian Style</em></h3>
						<p>How specialty coffee is finding new flavour through Indian traditions, sourced from Chikmagalur and Odisha.</p>
					</div>
				</a>

				<a href="/blog/pastries-coffee-pairing" class="photo-card reveal delay-300">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/10/butter-croissiant-sula-cafe-vancouver.webp" alt="Fresh-baked croissants and pastries Vancouver" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Pastry & Pairing</span>
						<h3>Pairing Pastries <em>with Chai & Coffee</em></h3>
						<p>The quiet ritual of choosing the right pastry. Why a buttery croissant and a strong masala chai belong together.</p>
					</div>
				</a>
			</div>
		</div>
	</section>

	<section class="section section-espresso reveal">
		<div class="container text-center">
			<span class="eyebrow-italic">Visit Us</span>
			<h2>Find us in <em>East Vancouver.</em></h2>
			<div class="premium-divider premium-divider-dark">
				<div class="pd-thin"></div>
				<div class="pd-thick"></div>
				<div class="pd-diamond"></div>
				<div class="pd-thick"></div>
				<div class="pd-thin-r"></div>
			</div>
			<p style="max-width:580px;margin:24px auto 36px">Five chai blends, full coffee menu, fresh bakery. 260 East 5th Avenue.</p>
			<a href="https://www.order.store/store/sula-cafe/0egsttFCUIahN8Ja4Uqhtw" class="cta" target="_blank" rel="noopener">
				<span class="cta-badge">
					<img src="/uploads/2025/09/sula-cafe-logo-2026.webp" alt="" loading="lazy" decoding="async" />
				</span>
				Order on UberEats
			</a>
		</div>
	</section>

</Layout>
