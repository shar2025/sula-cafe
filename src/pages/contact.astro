---
import Layout from '../layouts/Layout.astro';
---
<Layout
	title="Contact Sula Chai Café Vancouver | 260 East 5th Ave, East Vancouver"
	description="Visit Sula Chai Café at 260 East 5th Avenue, East Vancouver. Call 778-386-1130 or email info@sulacafe.com for orders, catering, and wholesale inquiries."
	canonical="/contact"
>

	<section class="hero">
		<div class="hero-content">
			<span class="eyebrow-italic">Get In Touch</span>
			<h1>Visit, call, <em>or write us.</em></h1>
			<div class="premium-divider">
				<div class="pd-thin"></div>
				<div class="pd-thick"></div>
				<div class="pd-diamond"></div>
				<div class="pd-thick"></div>
				<div class="pd-thin-r"></div>
			</div>
			<p class="hero-tagline">Find us in East Vancouver. Reach out for catering, wholesale, or just to say hello over a cup of chai.</p>
		</div>
	</section>

	<section class="section section-cream-reverse reveal">
		<div class="container">
			<div class="card-grid-3">
				<div class="card reveal delay-100">
					<div class="card-top-stripe"></div>
					<div class="card-img cocoa">
						<div class="pattern-overlay pattern-jaali"></div>
						<span class="card-img-label">Visit</span>
					</div>
					<div class="card-content">
						<span class="eyebrow">Address</span>
						<h3>260 East 5th Ave</h3>
						<p>East Vancouver, BC</p>
						<p style="margin-top:14px"><a href="https://maps.google.com/?q=260+East+5th+Ave+Vancouver+BC" target="_blank" rel="noopener" style="font-style:italic">Get Directions →</a></p>
					</div>
				</div>

				<div class="card reveal delay-200">
					<div class="card-top-stripe"></div>
					<div class="card-img espresso">
						<div class="pattern-overlay pattern-block"></div>
						<span class="card-img-label">Call</span>
					</div>
					<div class="card-content">
						<span class="eyebrow">Phone</span>
						<h3>778-386-1130</h3>
						<p>For general inquiries, catering bookings, and wholesale partnerships.</p>
						<p style="margin-top:14px"><a href="tel:7783861130" style="font-style:italic">Call Now →</a></p>
					</div>
				</div>

				<div class="card reveal delay-300">
					<div class="card-top-stripe"></div>
					<div class="card-img tan">
						<div class="pattern-overlay pattern-star"></div>
						<span class="card-img-label">Email</span>
					</div>
					<div class="card-content">
						<span class="eyebrow">Email</span>
						<h3>info@sulacafe.com</h3>
						<p>Send us your event details, dietary needs, or wholesale volumes. We respond within 24 hours.</p>
						<p style="margin-top:14px"><a href="mailto:info@sulacafe.com" style="font-style:italic">Email Us →</a></p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section section-cocoa reveal">
		<div class="container text-center">
			<span class="eyebrow-italic" style="color:var(--burnt-light)">Service Style</span>
			<h2>Takeout & <em>UberEats only.</em></h2>
			<div class="premium-divider premium-divider-dark">
				<div class="pd-thin"></div>
				<div class="pd-thick"></div>
				<div class="pd-diamond"></div>
				<div class="pd-thick"></div>
				<div class="pd-thin-r"></div>
			</div>
			<p style="max-width:620px;margin:24px auto 36px">Sula Chai Café is a takeout-only spot. Walk in to order at the counter, or have it delivered through UberEats.</p>
			<a href="https://www.order.store/store/sula-cafe/0egsttFCUIahN8Ja4Uqhtw" class="cta" target="_blank" rel="noopener">
				<span class="cta-badge">
					<img src="https://sulacafe.com/wp-content/uploads/2025/09/sula-cafe-logo-2026.webp" alt="" />
				</span>
				Order on UberEats
			</a>
		</div>
	</section>

	<section class="section section-espresso reveal">
		<div class="container text-center">
			<span class="eyebrow-italic">Catering & Wholesale</span>
			<h2>Bigger orders, <em>tailored proposals.</em></h2>
			<div class="premium-divider premium-divider-dark">
				<div class="pd-thin"></div>
				<div class="pd-thick"></div>
				<div class="pd-diamond"></div>
				<div class="pd-thick"></div>
				<div class="pd-thin-r"></div>
			</div>
			<p style="max-width:620px;margin:24px auto 36px">Hosting an event or running a business that needs reliable bakery supply? Tell us what you have in mind and we'll send a custom proposal.</p>
			<div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
				<a href="/catering" class="cta">
					<span class="cta-badge">
						<img src="https://sulacafe.com/wp-content/uploads/2025/09/sula-cafe-logo-2026.webp" alt="" />
					</span>
					Catering
				</a>
				<a href="/wholesale" class="btn-outline-cream">
					<span class="btn-badge">
						<img src="https://sulacafe.com/wp-content/uploads/2025/09/sula-cafe-logo-2026.webp" alt="" />
					</span>
					Wholesale
				</a>
			</div>
		</div>
	</section>

</Layout>
