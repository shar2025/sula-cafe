---
import Layout from '../layouts/Layout.astro';
---
<Layout
	title="Contact Sula Chai Café Vancouver | Visit, Call, Catering & Wholesale Inquiries"
	description="Get in touch with Sula Chai Café in East Vancouver. Visit at 260 East 5th Ave, call 778-386-1130, or email info@sulacafe.com for catering and wholesale inquiries."
	canonical="/contact"
>

	<section class="hero" style="min-height:50vh">
		<div class="hero-content">
			<span class="eyebrow-italic">Get In Touch</span>
			<h1>Visit. Call. <em>Or write.</em></h1>
			<div class="premium-divider">
				<div class="pd-thin"></div>
				<div class="pd-thick"></div>
				<div class="pd-diamond"></div>
				<div class="pd-thick"></div>
				<div class="pd-thin-r"></div>
			</div>
			<p class="hero-tagline">For catering, wholesale, or just to say hello , we'd love to hear from you.</p>
		</div>
	</section>

	<div class="section-divider">
		<div class="premium-divider">
			<div class="pd-thin"></div>
			<div class="pd-thick"></div>
			<img src="https://sulacafe.com/wp-content/uploads/2025/09/sula-cafe-logo-2026.webp" alt="" class="pd-logo" />
			<div class="pd-thick"></div>
			<div class="pd-thin-r"></div>
		</div>
	</div>

	<section class="section section-cream reveal">
		<div class="container">
			<div class="card-grid-3">
				<div class="card reveal delay-100">
					<div class="card-top-stripe"></div>
					<div class="card-img cocoa" style="height:180px">
						<div class="pattern-overlay pattern-jaali"></div>
						<span class="card-img-label">Visit</span>
					</div>
					<div class="card-content text-center">
						<span class="eyebrow">East Vancouver</span>
						<h3>Find Us <em>In Person</em></h3>
						<p style="margin-bottom:18px">260 East 5th Avenue<br/>Vancouver, BC</p>
						<a href="https://maps.google.com/?q=260+East+5th+Ave+Vancouver+BC" target="_blank" rel="noopener" style="font-family:'Playfair Display',Georgia,serif;font-style:italic;font-size:16px;color:var(--burnt);font-weight:500;border-bottom:1px solid var(--burnt);padding-bottom:2px">Get Directions</a>
					</div>
				</div>

				<div class="card reveal delay-200">
					<div class="card-top-stripe"></div>
					<div class="card-img espresso" style="height:180px">
						<div class="pattern-overlay pattern-block"></div>
						<span class="card-img-label">Call</span>
					</div>
					<div class="card-content text-center">
						<span class="eyebrow">Mon to Sun</span>
						<h3>Speak <em>With Us</em></h3>
						<p style="margin-bottom:18px">For orders, catering quotes, and wholesale inquiries</p>
						<a href="tel:7783861130" style="font-family:'Playfair Display',Georgia,serif;font-style:italic;font-size:18px;color:var(--burnt);font-weight:500;border-bottom:1px solid var(--burnt);padding-bottom:2px">778-386-1130</a>
					</div>
				</div>

				<div class="card reveal delay-300">
					<div class="card-top-stripe"></div>
					<div class="card-img tan" style="height:180px">
						<div class="pattern-overlay pattern-wave"></div>
						<span class="card-img-label">Email</span>
					</div>
					<div class="card-content text-center">
						<span class="eyebrow">We Reply Fast</span>
						<h3>Send Us A <em>Note</em></h3>
						<p style="margin-bottom:18px">Catering, wholesale, partnerships, anything else</p>
						<a href="mailto:info@sulacafe.com" style="font-family:'Playfair Display',Georgia,serif;font-style:italic;font-size:16px;color:var(--burnt);font-weight:500;border-bottom:1px solid var(--burnt);padding-bottom:2px">info@sulacafe.com</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section section-espresso reveal">
		<div class="container text-center">
			<span class="eyebrow-italic">Order Online</span>
			<h2>Or skip the call,<br/><em>order on UberEats.</em></h2>
			<div class="premium-divider premium-divider-dark">
				<div class="pd-thin"></div>
				<div class="pd-thick"></div>
				<div class="pd-diamond"></div>
				<div class="pd-thick"></div>
				<div class="pd-thin-r"></div>
			</div>
			<p style="max-width:560px;margin:24px auto 36px">Browse the full menu, customize your order, and have it delivered.</p>
			<a href="https://www.order.store/store/sula-cafe/0egsttFCUIahN8Ja4Uqhtw" class="cta" target="_blank" rel="noopener">
				<span class="cta-badge">
					<img src="https://sulacafe.com/wp-content/uploads/2025/09/sula-cafe-logo-2026.webp" alt="" />
				</span>
				Order on UberEats
			</a>
		</div>
	</section>

</Layout>
