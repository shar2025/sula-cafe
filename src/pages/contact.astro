---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
---
<Layout
	title="Cafe at 260 East 5th Ave, East Vancouver | Sula Café"
	description="Visit Sula Café at 260 East 5th Ave, East Vancouver. Call 778-386-1130 or email info@sulacafe.com for orders, catering, and wholesale inquiries."
	canonical="/contact"
	ogImage="/uploads/2026/02/sula-cafe-near-me-vancouver.webp"
	breadcrumbs={[
		{ name: 'Home', url: '/' },
		{ name: 'Contact', url: '/contact' }
	]}
>

	<section class="hero">
		<div class="hero-content">
			<span class="eyebrow-italic">Get In Touch</span>
			<h1>Visit, call, <em>or write us.</em></h1>
			<div class="premium-divider">
				<div class="pd-thin"></div>
				<div class="pd-thick"></div>
				<div class="pd-diamond"></div>
				<div class="pd-thick"></div>
				<div class="pd-thin-r"></div>
			</div>
			<p class="hero-tagline">Find us in East Vancouver. Reach out for catering, wholesale, or just to say hello over a cup of chai. Or read up on <a href="/coffee-and-chai-in-vancouver">chai in Vancouver</a> first.</p>
		</div>
	</section>

	<section class="section section-cream-reverse reveal">
		<div class="container">
			<div class="card-grid-3">
				<div class="card reveal delay-100">
					<div class="card-top-stripe"></div>
					<div class="card-img cocoa">
						<div class="pattern-overlay pattern-jaali"></div>
						<span class="card-img-label">Visit</span>
					</div>
					<div class="card-content">
						<span class="eyebrow">Address</span>
						<h3>260 East 5th Ave</h3>
						<p>East Vancouver, BC</p>
						<p style="margin-top:14px"><a href="https://maps.google.com/?q=260+East+5th+Ave+Vancouver+BC" target="_blank" rel="noopener" style="font-style:italic">Get Directions →</a></p>
					</div>
				</div>

				<div class="card reveal delay-200">
					<div class="card-top-stripe"></div>
					<div class="card-img espresso">
						<div class="pattern-overlay pattern-block"></div>
						<span class="card-img-label">Call</span>
					</div>
					<div class="card-content">
						<span class="eyebrow">Phone</span>
						<h3>778-386-1130</h3>
						<p>For general inquiries, catering bookings, and wholesale partnerships.</p>
						<p style="margin-top:14px"><a href="tel:7783861130" style="font-style:italic">Call Now →</a></p>
					</div>
				</div>

				<div class="card reveal delay-300">
					<div class="card-top-stripe"></div>
					<div class="card-img tan">
						<div class="pattern-overlay pattern-star"></div>
						<span class="card-img-label">Email</span>
					</div>
					<div class="card-content">
						<span class="eyebrow">Email</span>
						<h3>info@sulacafe.com</h3>
						<p>Send us your event details, dietary needs, or wholesale volumes. We respond within 24 hours.</p>
						<p style="margin-top:14px"><a href="mailto:info@sulacafe.com" style="font-style:italic">Email Us →</a></p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<LeadForm defaultReason="general" />

	<section class="section section-cocoa reveal">
		<div class="container text-center">
			<span class="eyebrow-italic" style="color:var(--burnt-light)">Service Style</span>
			<h2>Takeout & <em>UberEats only.</em></h2>
			<div class="premium-divider premium-divider-dark">
				<div class="pd-thin"></div>
				<div class="pd-thick"></div>
				<div class="pd-diamond"></div>
				<div class="pd-thick"></div>
				<div class="pd-thin-r"></div>
			</div>
			<p style="max-width:620px;margin:24px auto 36px">Sula Café is a takeout-only <a href="/" style="color:var(--burnt-light)">coffee shop in East Vancouver</a>. Walk in to order at the counter, or have it delivered through UberEats.</p>
			<a href="https://www.order.store/store/sula-cafe/0egsttFCUIahN8Ja4Uqhtw" class="cta" target="_blank" rel="noopener">
				<span class="cta-badge">
					<img width="300" height="136" src="/uploads/2025/09/sula-cafe-logo-2026.webp" alt="" loading="lazy" decoding="async" />
				</span>
				Order on UberEats
			</a>
		</div>
	</section>

	<section class="section section-cream-deep reveal" id="faq">
		<div class="container container-narrow">
			<div class="intro-block">
				<span class="eyebrow-italic">Quick Answers</span>
				<h2>Before you <em>reach out.</em></h2>
				<div class="premium-divider">
					<div class="pd-thin"></div>
					<div class="pd-thick"></div>
					<div class="pd-diamond"></div>
					<div class="pd-thick"></div>
					<div class="pd-thin-r"></div>
				</div>
				<p>Hours, transit, orders, and feedback. The things people ask most.</p>
			</div>

			<div class="faq-list">
				<details class="faq-item">
					<summary>
						<span class="faq-q">When are you open?</span>
						<span class="faq-icon" aria-hidden="true">+</span>
					</summary>
					<div class="faq-a">
						<p>Monday through Friday from 8am to 5:30pm. Weekends 9am to 5:30pm. Open daily.</p>
					</div>
				</details>

				<details class="faq-item">
					<summary>
						<span class="faq-q">How do I get there by transit?</span>
						<span class="faq-icon" aria-hidden="true">+</span>
					</summary>
					<div class="faq-a">
						<p>We're a 5-minute walk from Main Street-Science World SkyTrain station. The 3 Main Street bus stops a block away.</p>
					</div>
				</details>

				<details class="faq-item">
					<summary>
						<span class="faq-q">Do you take phone orders?</span>
						<span class="faq-icon" aria-hidden="true">+</span>
					</summary>
					<div class="faq-a">
						<p>Yes. Call 778-386-1130 and we'll have your order ready for pickup.</p>
					</div>
				</details>

				<details class="faq-item">
					<summary>
						<span class="faq-q">Can I order delivery?</span>
						<span class="faq-icon" aria-hidden="true">+</span>
					</summary>
					<div class="faq-a">
						<p>Yes. We're on UberEats with the full menu. Same-day delivery across East Vancouver.</p>
					</div>
				</details>

				<details class="faq-item">
					<summary>
						<span class="faq-q">Is there a way to provide feedback?</span>
						<span class="faq-icon" aria-hidden="true">+</span>
					</summary>
					<div class="faq-a">
						<p>Email info@sulacafe.com. We read every message and respond within 24 hours.</p>
					</div>
				</details>
			</div>
		</div>
	</section>

	<script type="application/ld+json" slot="schema" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"mainEntity": [
			{ "@type": "Question", "name": "When are you open?", "acceptedAnswer": { "@type": "Answer", "text": "Monday through Friday from 8am to 5:30pm. Weekends 9am to 5:30pm. Open daily." } },
			{ "@type": "Question", "name": "How do I get there by transit?", "acceptedAnswer": { "@type": "Answer", "text": "We're a 5-minute walk from Main Street-Science World SkyTrain station. The 3 Main Street bus stops a block away." } },
			{ "@type": "Question", "name": "Do you take phone orders?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Call 778-386-1130 and we'll have your order ready for pickup." } },
			{ "@type": "Question", "name": "Can I order delivery?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We're on UberEats with the full menu. Same-day delivery across East Vancouver." } },
			{ "@type": "Question", "name": "Is there a way to provide feedback?", "acceptedAnswer": { "@type": "Answer", "text": "Email info@sulacafe.com. We read every message and respond within 24 hours." } }
		]
	})} />

	<section class="section section-espresso reveal">
		<div class="container text-center">
			<span class="eyebrow-italic">Catering & Wholesale</span>
			<h2>Bigger orders, <em>tailored proposals.</em></h2>
			<div class="premium-divider premium-divider-dark">
				<div class="pd-thin"></div>
				<div class="pd-thick"></div>
				<div class="pd-diamond"></div>
				<div class="pd-thick"></div>
				<div class="pd-thin-r"></div>
			</div>
			<p style="max-width:620px;margin:24px auto 36px">Hosting an event? Our <a href="/catering" style="color:var(--burnt-light)">catering in Vancouver</a> is built for it. Running a business that needs supply? See our <a href="/wholesale" style="color:var(--burnt-light)">wholesale bakery in Vancouver</a>.</p>
			<div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
				<a href="/catering" class="cta">
					<span class="cta-badge">
						<img width="300" height="136" src="/uploads/2025/09/sula-cafe-logo-2026.webp" alt="" loading="lazy" decoding="async" />
					</span>
					Catering
				</a>
				<a href="/wholesale" class="btn-outline-cream">
					<span class="btn-badge">
						<img width="300" height="136" src="/uploads/2025/09/sula-cafe-logo-2026.webp" alt="" loading="lazy" decoding="async" />
					</span>
					Wholesale
				</a>
			</div>
		</div>
	</section>

</Layout>
