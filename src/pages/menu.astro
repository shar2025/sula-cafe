---
import Layout from '../layouts/Layout.astro';

const menuSchema = {
	"@context": "https://schema.org",
	"@type": "Menu",
	"@id": "https://sulacafe.com/menu/#menu",
	"name": "Sula Chai Café Menu",
	"description": "Five chai blends, the Alai Coffee menu, paninis on masala focaccia, croissants, cruffins, samosas, cookies and macaroons.",
	"inLanguage": "en-CA",
	"provider": { "@id": "https://sulacafe.com/#organization" },
	"hasMenuSection": [
		{
			"@type": "MenuSection",
			"@id": "https://sulacafe.com/menu/#chai",
			"name": "Sula Chai",
			"description": "Premium tea leaves from Coorg and Chikmagalur, slow-brewed with traditional spices.",
			"hasMenuItem": [
				{ "@type": "MenuItem", "name": "Sula Classic Masala Chai", "description": "Cardamom, ginger, clove and pepper, slow-brewed with Assam tea and whole milk." },
				{ "@type": "MenuItem", "name": "Lavender Chai", "description": "Soft lavender notes layered into our masala base. Aromatic and soothing." },
				{ "@type": "MenuItem", "name": "Pistachio Chai", "description": "Roasted pistachios infused into rich masala chai. Nutty, creamy, decadent." },
				{ "@type": "MenuItem", "name": "Spicy Ginger Chai", "description": "Generous fresh ginger for a sharp, warming brew. The morning wake-up call." },
				{ "@type": "MenuItem", "name": "Gulabi Chai", "description": "Rose petal chai with a delicate floral finish. Pink, fragrant, romantic." }
			]
		},
		{
			"@type": "MenuSection",
			"@id": "https://sulacafe.com/menu/#coffee",
			"name": "Alai Coffee",
			"description": "Exclusive Sula Blend by Alai Coffee, sourced from Chikmagalur and Odisha.",
			"hasMenuItem": [
				{ "@type": "MenuItem", "name": "Jaggery Velvet Latte", "description": "Smooth espresso with traditional Indian jaggery. Earthy sweetness, velvety finish." },
				{ "@type": "MenuItem", "name": "Masala Monsoon Misto", "description": "Espresso meets warming masala spice. Half coffee, half steamed milk." },
				{ "@type": "MenuItem", "name": "Coastal Coconut Cappuccino", "description": "Espresso with coconut milk foam. Toasted, tropical, distinctly Indian." },
				{ "@type": "MenuItem", "name": "Malai Pista Mocha", "description": "Rich pistachio cream and chocolate over espresso. Indian dessert in a cup." },
				{ "@type": "MenuItem", "name": "Indian Filter Coffee", "description": "Traditional South Indian filter coffee. Robust, frothy, served the proper way." }
			]
		},
		{
			"@type": "MenuSection",
			"@id": "https://sulacafe.com/menu/#savory",
			"name": "Savoury",
			"description": "Paninis on house-made masala focaccia, samosas, soups, and savoury croissants.",
			"hasMenuItem": [
				{ "@type": "MenuItem", "name": "Chimichurri Paneer Panini", "description": "Fresh chimichurri spread, masala paneer, spinach, mozzarella, sundried tomatoes, arugula. Pressed in masala focaccia.", "suitableForDiet": "https://schema.org/VegetarianDiet" },
				{ "@type": "MenuItem", "name": "Pesto Chicken Tikka Panini", "description": "Juicy chicken tikka, fresh pesto, tandoori spicy mayo, mozzarella, sundried tomatoes, arugula. Pressed in masala focaccia." },
				{ "@type": "MenuItem", "name": "Paneer or Chicken Panini XL", "description": "Pesto or chimichurri, tandoori mayo, mozzarella, sundried tomatoes, arugula. In masala focaccia." },
				{ "@type": "MenuItem", "name": "Masala Tomato & Red Pepper Soup", "description": "Slow-roasted tomatoes and red peppers, simmered with warming Indian spices.", "suitableForDiet": "https://schema.org/VegetarianDiet" },
				{ "@type": "MenuItem", "name": "Herb Chutney Cheese Croissant", "description": "Spiced green chutney layered with melted cheese inside a buttery croissant.", "suitableForDiet": "https://schema.org/VegetarianDiet" },
				{ "@type": "MenuItem", "name": "Vegetable Samosa", "description": "Homemade classic vegetable samosas served with tamarind and mint chutneys.", "suitableForDiet": "https://schema.org/VegetarianDiet" },
				{ "@type": "MenuItem", "name": "Samosa Croissant", "description": "Peas, potatoes, and warming spices folded into a flaky croissant.", "suitableForDiet": "https://schema.org/VegetarianDiet" }
			]
		},
		{
			"@type": "MenuSection",
			"@id": "https://sulacafe.com/menu/#sweets",
			"name": "Sweets",
			"description": "Cruffins, croissants, and pastries baked fresh every morning.",
			"hasMenuItem": [
				{ "@type": "MenuItem", "name": "Butter Croissant", "description": "Crisp, buttery layers and a tender, airy crumb. The classic, done right.", "suitableForDiet": "https://schema.org/VegetarianDiet" },
				{ "@type": "MenuItem", "name": "Spiced Morning Glory Muffin", "description": "Carrots, apples, coconut and warm spices. Sugar-free, deeply satisfying.", "suitableForDiet": ["https://schema.org/VegetarianDiet", "https://schema.org/DiabeticDiet"] },
				{ "@type": "MenuItem", "name": "Lime Coconut Cruffin", "description": "Flaky cruffin filled with tangy lime curd and sprinkled with toasted coconut.", "suitableForDiet": "https://schema.org/VegetarianDiet" },
				{ "@type": "MenuItem", "name": "Tiramisu Cruffin", "description": "Espresso-mascarpone cream, dusted with cocoa and a hint of cardamom.", "suitableForDiet": "https://schema.org/VegetarianDiet" },
				{ "@type": "MenuItem", "name": "Orange Chocolate Pain Suisse", "description": "Fragrant orange zest meets silky dark chocolate.", "suitableForDiet": "https://schema.org/VegetarianDiet" },
				{ "@type": "MenuItem", "name": "Pistachio Loaf", "description": "Sweet pistachio loaf finished with pistachio crumb icing.", "suitableForDiet": "https://schema.org/VegetarianDiet" }
			]
		},
		{
			"@type": "MenuSection",
			"@id": "https://sulacafe.com/menu/#cookies",
			"name": "Cookies & Macaroons",
			"description": "Spiced, malai-soaked, espresso-deep, or simply chocolate chip.",
			"hasMenuItem": [
				{ "@type": "MenuItem", "name": "Chocolate Chip Cookies", "description": "Soft, chewy, generous chocolate chunks.", "suitableForDiet": "https://schema.org/VegetarianDiet" },
				{ "@type": "MenuItem", "name": "Brown Butter Espresso Cookies", "description": "Brown butter and espresso baked into nutty buckwheat flour.", "suitableForDiet": "https://schema.org/VegetarianDiet" },
				{ "@type": "MenuItem", "name": "Pistachio Malai Macaroons", "description": "Soft macaroons soaked in pistachio malai cream.", "suitableForDiet": "https://schema.org/VegetarianDiet" }
			]
		}
	]
};
---
<Layout
	title="Menu | Specialty Chai & Coffee in East Vancouver | Sula"
	description="Five chai blends from Coorg, Alai Coffee, paninis on masala focaccia, fresh pastries. Real chai and specialty coffee in East Vancouver."
	canonical="/menu"
	ogImage="/uploads/2025/12/cappuccino.jpg"
	breadcrumbs={[
		{ name: 'Home', url: '/' },
		{ name: 'Menu', url: '/menu' }
	]}
>
	<style is:global>
		/* Force reveal animations to render visible on this page — IntersectionObserver timing on mobile was leaving sections hidden mid-scroll, creating perceived empty gaps. */
		body:has(#chai) .reveal,
		body:has(#chai) .reveal-left,
		body:has(#chai) .reveal-right,
		body:has(#chai) .reveal-scale{opacity:1 !important;transform:none !important}
	</style>

	<section class="hero">
		<div class="hero-content">
			<span class="eyebrow-italic">Sula Chai Café Menu</span>
			<h1>Sip, savour, <em>and indulge.</em></h1>
			<div class="premium-divider">
				<div class="pd-thin"></div>
				<div class="pd-thick"></div>
				<div class="pd-diamond"></div>
				<div class="pd-thick"></div>
				<div class="pd-thin-r"></div>
			</div>
			<p class="hero-tagline">Authentic Sula chai. Exclusive Alai Coffee. Indian-inspired baked goods made fresh every morning. Paninis pressed in masala focaccia. Made fresh in our <a href="/">coffee shop in East Vancouver</a>.</p>
			<div class="hero-buttons">
				<a href="https://www.order.store/store/sula-cafe/0egsttFCUIahN8Ja4Uqhtw" class="cta" target="_blank" rel="noopener">
					<span class="cta-badge">
						<img src="/uploads/2025/09/sula-cafe-logo-2026.webp" alt="" loading="lazy" decoding="async" />
					</span>
					Order on UberEats
				</a>
			</div>
		</div>
	</section>

	<section class="section section-cocoa reveal" id="chai">
		<div class="container">
			<div class="intro-block">
				<span class="eyebrow-italic" style="color:var(--burnt-light)">Sula Chai</span>
				<h2>Chai blends, <em>brewed slow.</em></h2>
				<div class="premium-divider premium-divider-dark">
					<div class="pd-thin"></div>
					<div class="pd-thick"></div>
					<div class="pd-diamond"></div>
					<div class="pd-thick"></div>
					<div class="pd-thin-r"></div>
				</div>
				<p>Premium Indian tea leaves from Coorg and Chikmagalur. Layered with traditional spices and nostalgic Indian flavours, reimagined into modern artisanal chai. Real chai near East Vancouver, brewed the proper way. More on <a href="/coffee-and-chai-in-vancouver">chai in Vancouver</a>, if you want the longer story.</p>
			</div>

			<div class="card-grid-3" style="margin-top:60px">
				<div class="photo-card reveal delay-100">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/10/Masala-chai.webp" alt="Sula classic masala chai brewed slow at our East Vancouver coffee shop" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Hand-Brewed</span>
						<h3>Sula Classic <em>Masala Chai</em></h3>
						<p>Cardamom, ginger, clove and pepper, slow-brewed with Assam tea and whole milk.</p>
					</div>
				</div>

				<div class="photo-card reveal delay-200">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/10/Lavender-chai.webp" alt="Lavender Chai" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Floral & Calm</span>
						<h3>Lavender <em>Chai</em></h3>
						<p>Soft lavender notes layered into our masala base. Aromatic and soothing.</p>
					</div>
				</div>

				<div class="photo-card reveal delay-300">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/10/IMG_2965.webp" alt="Pistachio Chai" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">From Royal Kitchens</span>
						<h3>Pistachio <em>Chai</em></h3>
						<p>Roasted pistachios infused into rich masala chai. Nutty, creamy, decadent.</p>
					</div>
				</div>

				<div class="photo-card reveal delay-100" style="margin-top:24px">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/10/chai-near-me-2.webp" alt="Spicy Ginger Chai" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Bold & Warming</span>
						<h3>Spicy Ginger <em>Chai</em></h3>
						<p>Generous fresh ginger for a sharp, warming brew. The morning wake-up call.</p>
					</div>
				</div>

				<div class="photo-card reveal delay-200" style="margin-top:24px">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/10/Rose-chai.webp" alt="Gulabi Chai with rose petals" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">From Ancient Markets</span>
						<h3>Gulabi <em>Chai</em></h3>
						<p>Rose petal chai with a delicate floral finish. Pink, fragrant, romantic.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section section-tan reveal" id="coffee">
		<div class="container">
			<div class="intro-block">
				<span class="eyebrow-italic">Alai Coffee</span>
				<h2>Crafted by Alai. <em>Brewed at Sula.</em></h2>
				<div class="premium-divider">
					<div class="pd-thin"></div>
					<div class="pd-thick"></div>
					<div class="pd-diamond"></div>
					<div class="pd-thick"></div>
					<div class="pd-thin-r"></div>
				</div>
				<p>Exclusive Sula Blend by Alai Coffee, sourced from Chikmagalur and Odisha. Original creations inspired by India's dessert traditions. More on <a href="/blog/specialty-coffee-vancouver">specialty coffee in Vancouver</a> in the journal.</p>
			</div>

			<div class="card-grid-3" style="margin-top:60px">
				<div class="photo-card reveal delay-100">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/12/a4.jpg" alt="Jaggery Velvet Latte" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Warm Jaggery</span>
						<h3>Jaggery Velvet <em>Latte</em></h3>
						<p>Smooth espresso with traditional Indian jaggery. Earthy sweetness, velvety finish.</p>
					</div>
				</div>

				<div class="photo-card reveal delay-200">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/12/a2.jpg" alt="Masala Monsoon Misto" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Monsoon Spice</span>
						<h3>Masala Monsoon <em>Misto</em></h3>
						<p>Espresso meets warming masala spice. Half coffee, half steamed milk, all character.</p>
					</div>
				</div>

				<div class="photo-card reveal delay-300">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/12/cappuccino.jpg" alt="Coastal Coconut Cappuccino" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Coast of Kerala</span>
						<h3>Coastal Coconut <em>Cappuccino</em></h3>
						<p>Espresso with coconut milk foam. Toasted, tropical, distinctly Indian.</p>
					</div>
				</div>

				<div class="photo-card reveal delay-100">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/12/a3.jpg" alt="Malai Pista Mocha" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Fragrant Pistachio</span>
						<h3>Malai Pista <em>Mocha</em></h3>
						<p>Rich pistachio cream and chocolate over espresso. Indian dessert in a cup.</p>
					</div>
				</div>

				<div class="photo-card reveal delay-200">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/09/filter-coffee.webp" alt="Indian filter coffee at our East Vancouver coffee shop" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">South Indian</span>
						<h3>Indian Filter <em>Coffee</em></h3>
						<p>Traditional South Indian filter coffee. Robust, frothy, served the proper way.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section section-cocoa reveal" id="savory">
		<div class="container">
			<div class="intro-block">
				<span class="eyebrow-italic" style="color:var(--burnt-light)">Savoury</span>
				<h2>Paninis & <em>street food.</em></h2>
				<div class="premium-divider premium-divider-dark">
					<div class="pd-thin"></div>
					<div class="pd-thick"></div>
					<div class="pd-diamond"></div>
					<div class="pd-thick"></div>
					<div class="pd-thin-r"></div>
				</div>
				<p>House-made masala focaccia from Union Market, samosas with chutneys, and warming masala soups. Comfort food with depth.</p>
			</div>

			<div class="card-grid-3" style="margin-top:60px">
				<div class="photo-card reveal delay-100">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/10/PXL_20251217_194925352.PORTRAIT.webp" alt="Chimichurri Paneer Panini" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Vegetarian</span>
						<h3>Chimichurri Paneer <em>Panini</em></h3>
						<p>Fresh chimichurri spread, masala paneer, spinach, mozzarella, sundried tomatoes, arugula. Pressed in masala focaccia.</p>
					</div>
				</div>

				<div class="photo-card reveal delay-200">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/10/Pesto-chicken-tikka-panini.webp" alt="Pesto Chicken Tikka Panini" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Bestseller</span>
						<h3>Pesto Chicken Tikka <em>Panini</em></h3>
						<p>Juicy chicken tikka, fresh pesto, tandoori spicy mayo, mozzarella, sundried tomatoes, arugula. Pressed in masala focaccia.</p>
					</div>
				</div>

				<div class="photo-card reveal delay-300">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/10/cafe-near-me.webp" alt="Paneer or Chicken Panini XL" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Hearty Size</span>
						<h3>Paneer/Chicken <em>Panini XL</em></h3>
						<p>The full version. Pesto or chimichurri, tandoori mayo, mozzarella, sundried tomatoes, arugula. In masala focaccia.</p>
					</div>
				</div>

				<div class="photo-card reveal delay-100" style="margin-top:24px">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/12/tomato-red-pepper-soup.webp" alt="Masala Tomato Red Pepper Soup" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Comfort</span>
						<h3>Masala Tomato & <em>Red Pepper Soup</em></h3>
						<p>Slow-roasted tomatoes and red peppers, simmered with warming Indian spices. Velvety, rich.</p>
					</div>
				</div>

				<div class="photo-card reveal delay-200" style="margin-top:24px">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/10/Chutney-cheese-croissant.webp" alt="Herb Chutney Cheese Croissant" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Savoury Pastry</span>
						<h3>Herb Chutney <em>Cheese Croissant</em></h3>
						<p>Spiced green chutney layered with melted cheese inside a buttery croissant.</p>
					</div>
				</div>

				<div class="photo-card reveal delay-300" style="margin-top:24px">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/10/samosa-near-me.webp" alt="Vegetable Samosa with chutneys" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Classic Street Food</span>
						<h3>Vegetable <em>Samosa</em></h3>
						<p>Homemade classic vegetable samosas served with tamarind and mint chutneys.</p>
					</div>
				</div>

				<div class="photo-card reveal delay-100" style="margin-top:24px">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/12/chai-near-me.webp" alt="Samosa Croissant" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Sula Original</span>
						<h3>Samosa <em>Croissant</em></h3>
						<p>Twist on the classic. Peas, potatoes, and warming spices folded into a flaky croissant.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section section-tan reveal" id="sweets">
		<div class="container">
			<div class="intro-block">
				<span class="eyebrow-italic">Sweets</span>
				<h2>Cruffins, croissants, <em>and pastries.</em></h2>
				<div class="premium-divider">
					<div class="pd-thin"></div>
					<div class="pd-thick"></div>
					<div class="pd-diamond"></div>
					<div class="pd-thick"></div>
					<div class="pd-thin-r"></div>
				</div>
				<p>Indian local bakery favourites with a Vancouver twist. Spiced, layered, and freshly baked every morning. Notes on the <a href="/blog/pastries-coffee-pairing">best croissant in Vancouver</a> over in the journal.</p>
			</div>

			<div class="card-grid-3" style="margin-top:60px">
				<div class="photo-card reveal delay-100">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/10/butter-croissiant-sula-cafe-vancouver.webp" alt="Butter Croissant" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Classic French</span>
						<h3>Butter <em>Croissant</em></h3>
						<p>Crisp, buttery layers and a tender, airy crumb. The classic, done right.</p>
					</div>
				</div>

				<div class="photo-card reveal delay-200">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/10/morning-glory-muffin-sugar-free.webp" alt="Spiced Morning Glory Muffin sugar free" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
						<span class="eyebrow">Sugar Free</span>
						<h3>Spiced Morning <em>Glory Muffin</em></h3>
						<p>A wholesome blend of carrots, apples, coconut and warm spices. Sugar-free, deeply satisfying.</p>
					</div>
				</div>

				<div class="photo-card reveal delay-300">
					<div class="photo-card-top-stripe"></div>
					<div class="photo-card-img portrait">
						<img src="/uploads/2025/10/Coconut-lime-cruffin.webp" alt="Lime Coconut Cruffin" loading="lazy" decoding="async" />
					</div>
					<div class="photo-card-content">
