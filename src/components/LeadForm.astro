---
/**
 * LeadForm: the cafe's lead capture form. Posts to /api/lead, which writes the
 * lead into the shared Dhruv Labs dashboard (dl_leads) and optionally emails
 * the team. Drop it on any page, it renders its own section.
 *
 *   <LeadForm defaultReason="catering" />
 *
 * defaultReason presets the dropdown and the heading copy. The form also reads
 * a ?reason= query param so deep links from other pages land on the right one.
 */
interface Props {
  defaultReason?: 'general' | 'catering' | 'wholesale' | 'feedback';
  heading?: string;
  blurb?: string;
}
const { defaultReason = 'general', heading, blurb } = Astro.props;

const copy = {
  general: {
    eyebrow: 'Get In Touch',
    h: 'Send us a message',
    b: 'Questions, feedback, or a hello over a cup of chai. We read every message and reply within 24 hours.',
  },
  catering: {
    eyebrow: 'Catering Inquiry',
    h: 'Tell us about your event',
    b: 'Live chai bars, specialty coffee, and bakery boxes. Share your date and headcount and we will send a custom proposal within 24 hours.',
  },
  wholesale: {
    eyebrow: 'Wholesale Inquiry',
    h: 'Start a wholesale order',
    b: 'Tell us your volume, dietary requirements, and timeline. We will prepare custom pricing within 48 hours.',
  },
  feedback: {
    eyebrow: 'Get In Touch',
    h: 'Send us a message',
    b: 'We read every message and reply within 24 hours.',
  },
};
const c = copy[defaultReason];
const h = heading || c.h;
const b = blurb || c.b;
const reasons = [
  { value: 'general', label: 'General inquiry' },
  { value: 'catering', label: 'Catering' },
  { value: 'wholesale', label: 'Wholesale' },
  { value: 'feedback', label: 'Feedback' },
];
---

<section class="section section-cream-deep reveal" id="inquiry">
  <div class="container container-narrow">
    <div class="intro-block" style="text-align:center">
      <span class="eyebrow-italic">{c.eyebrow}</span>
      <h2>{h}</h2>
      <p style="max-width:560px;margin:18px auto 0">{b}</p>
    </div>

    <form id="lead-form" class="lead-form" novalidate>
      <input type="hidden" name="reason" id="lead-reason" value={defaultReason} />

      <div class="lead-grid">
        <label class="lead-field">
          <span>Name</span>
          <input type="text" name="name" maxlength="120" autocomplete="name" required />
        </label>
        <label class="lead-field">
          <span>Phone</span>
          <input type="tel" name="phone" maxlength="40" autocomplete="tel" />
        </label>
        <label class="lead-field">
          <span>Email</span>
          <input type="email" name="email" maxlength="160" autocomplete="email" />
        </label>
        <label class="lead-field">
          <span>What is this about?</span>
          <select name="reasonSelect" id="lead-reason-select">
            {reasons.map((r) => (
              <option value={r.value} selected={r.value === defaultReason}>{r.label}</option>
            ))}
          </select>
        </label>
      </div>

      <label class="lead-field">
        <span>Event or delivery date <em>(optional)</em></span>
        <input type="text" name="eventDate" maxlength="60" placeholder="e.g. June 14, or flexible" />
      </label>

      <label class="lead-field">
        <span>Your message</span>
        <textarea name="message" maxlength="4000" rows="5" required
          placeholder="Tell us what you need. For catering or wholesale, headcount and any dietary needs help us quote faster."></textarea>
      </label>

      <input type="text" name="company" class="lead-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="lead-foot">
        <button type="submit" class="lead-submit">Send message</button>
        <p class="lead-note">An email or a phone number, whichever you prefer.</p>
      </div>
      <p class="lead-status" id="lead-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .lead-form {
    max-width: 720px;
    margin: 40px auto 0;
    background: var(--cream);
    border: 1px solid rgba(92, 64, 49, 0.18);
    border-radius: 4px;
    padding: 32px;
    box-shadow: 0 18px 44px rgba(45, 27, 20, 0.12);
  }
  .lead-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .lead-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 18px;
  }
  .lead-grid .lead-field { margin-bottom: 0; }
  .lead-field span {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--cocoa-mid);
  }
  .lead-field span em {
    font-family: Georgia, serif;
    font-style: italic;
    text-transform: none;
    letter-spacing: 0;
    color: var(--text-soft);
    font-weight: 400;
  }
  .lead-field input,
  .lead-field select,
  .lead-field textarea {
    font-family: Georgia, serif;
    font-size: 16px;
    color: var(--text-dark);
    background: #fffdf8;
    border: 1px solid rgba(92, 64, 49, 0.28);
    border-radius: 3px;
    padding: 12px 14px;
    width: 100%;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .lead-field textarea { resize: vertical; line-height: 1.5; }
  .lead-field input:focus,
  .lead-field select:focus,
  .lead-field textarea:focus {
    border-color: var(--burnt);
    box-shadow: 0 0 0 3px rgba(193, 121, 67, 0.16);
  }
  .lead-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .lead-foot {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  .lead-submit {
    background: linear-gradient(135deg, var(--burnt-deep) 0%, var(--burnt) 50%, var(--burnt-light) 100%);
    color: var(--text-dark);
    border: 1px solid var(--burnt);
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 2.5px;
    font-weight: 600;
    text-transform: uppercase;
    height: 52px;
    padding: 0 34px;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .lead-submit:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(193, 121, 67, 0.4);
  }
  .lead-submit:disabled { opacity: 0.6; cursor: not-allowed; }
  .lead-note {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: 13px;
    color: var(--text-soft);
    margin: 0;
  }
  .lead-status {
    margin: 16px 0 0;
    font-family: Georgia, serif;
    font-size: 15px;
    min-height: 1px;
  }
  .lead-status-ok { color: var(--burnt-deep); }
  .lead-status-err { color: #9a2f2f; }
  @media (max-width: 600px) {
    .lead-form { padding: 24px; }
    .lead-grid { grid-template-columns: 1fr; gap: 0; }
    .lead-grid .lead-field { margin-bottom: 18px; }
  }
</style>

<script is:inline>
  (() => {
    const form = document.getElementById('lead-form');
    const statusEl = document.getElementById('lead-status');
    const reasonHidden = document.getElementById('lead-reason');
    const reasonSelect = document.getElementById('lead-reason-select');
    if (!form || !statusEl || !reasonHidden || !reasonSelect) return;

    const valid = ['general', 'catering', 'wholesale', 'feedback'];

    // Deep link support: /contact?reason=catering presets the dropdown.
    const urlReason = new URLSearchParams(location.search).get('reason');
    if (urlReason && valid.includes(urlReason)) {
      reasonSelect.value = urlReason;
    }
    const sync = () => { reasonHidden.value = reasonSelect.value; };
    sync();
    reasonSelect.addEventListener('change', sync);

    const setStatus = (msg, kind) => {
      statusEl.textContent = msg;
      statusEl.className = 'lead-status' + (kind ? ' lead-status-' + kind : '');
    };

    let busy = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (busy) return;
      const fd = new FormData(form);
      const data = {
        name: (fd.get('name') || '').toString().trim(),
        email: (fd.get('email') || '').toString().trim(),
        phone: (fd.get('phone') || '').toString().trim(),
        reason: (fd.get('reason') || 'general').toString(),
        eventDate: (fd.get('eventDate') || '').toString().trim(),
        message: (fd.get('message') || '').toString().trim(),
        company: (fd.get('company') || '').toString(),
      };
      if (!data.name) { setStatus('Please add your name.', 'err'); return; }
      if (!data.email && !data.phone) {
        setStatus('Please add an email or a phone number so we can reply.', 'err');
        return;
      }
      if (!data.message) { setStatus('Please add a short message.', 'err'); return; }

      const btn = form.querySelector('.lead-submit');
      busy = true;
      btn.disabled = true;
      btn.textContent = 'Sending...';
      setStatus('', '');
      try {
        const r = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const out = await r.json().catch(() => ({}));
        if (r.ok && out.ok) {
          form.reset();
          sync();
          setStatus('Thank you. Your message is in, we will reply within 24 hours.', 'ok');
        } else {
          setStatus(out.error || 'Something went wrong. Please email info@sulacafe.com.', 'err');
        }
      } catch (err) {
        setStatus('Could not connect. Please email info@sulacafe.com or call 778 386 1130.', 'err');
      } finally {
        busy = false;
        btn.disabled = false;
        btn.textContent = 'Send message';
      }
    });
  })();
</script>
